{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ExpenseHub": "Data Source=expensehub.db"
  },
  "Jwt": {
    "Issuer": "ExpenseHub.Api",
    "Audience": "ExpenseHub.Clients",
    "ExpirationMinutes": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "expensehub",
    "QueueName": "expensehub.reports.requested"
  },
  "Seed": {
    "AdminEmail": "admin@expensehub.local"
  }
}
